# Environment Variables for External APIs

# Meditrone AI API Configuration
MEDITRONE_AI_API_URL=https://api.meditrone.ai/v1
MEDITRONE_AI_API_KEY=your_meditrone_api_key_here

# Open FDA API (no key required, but you can add rate limit handling)
OPEN_FDA_API_URL=https://api.fda.gov/drug/label.json

# API Rate Limiting and Caching
EXTERNAL_API_CACHE_TTL=86400000  # 24 hours in milliseconds
EXTERNAL_API_TIMEOUT=30000        # 30 seconds timeout
EXTERNAL_API_RETRY_ATTEMPTS=3    # Number of retry attempts

# Feature Flags
ENABLE_EXTERNAL_INTERACTIONS=true
ENABLE_OPENFDA=true
ENABLE_MEDITRONE_AI=true

# Database Settings for External Data
SYNC_EXTERNAL_INTERACTIONS_ON_STARTUP=false
EXTERNAL_INTERACTIONS_BATCH_SIZE=50
